PORT=4000
JWT_SECRET=change-me-in-production
TRACKING_BASE_URL=https://rflx.app/t

# Set these to send real SMS via Africa's Talking. Without them, SMS is
# mocked and only visible on the app's "SMS log" page / GET /api/sms/outbox.
# Get credentials at https://account.africastalking.com — sandbox keys work
# for testing, but in sandbox mode only phone numbers you've added as
# simulator recipients in your AT dashboard will actually receive texts.
# AT_API_KEY=
# AT_USERNAME=
# AT_SHORTCODE=
